// Optional module: the in-game menu (tabs, themes, styles, info buttons).
// If this file ever fails to compile, delete it: Geode's normal settings page opens
// instead (with a notice), and everything else still works.
#include "rsp.hpp"

#include <Geode/ui/Popup.hpp>
#include <cmath>

namespace {

enum Kind { kToggle = 0, kInt = 1, kFloat = 2, kChoice = 3 };

struct Row {
	Kind kind;
	char const* key;
	char const* label;
	char const* info;
	double lo;
	double hi;
	double step;
	std::vector<std::string> opts;
};
struct Page {
	char const* name;
	std::vector<Row> rows;
};

