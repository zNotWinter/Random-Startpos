std::string fmtVal(Row const& r) {
	if (r.kind == kToggle) return "";
	if (r.kind == kChoice) {
		std::string v = rspOpt<std::string>(r.key);
		if (v.size() > 4 && v.compare(v.size() - 4, 4, ".ogg") == 0) v.resize(v.size() - 4);
		return v;
	}
	std::string k = r.key;
	if (r.kind == kInt) {
		int64_t v = rspOpt<int64_t>(r.key);
		if (v == 0 && k == "give-up-after") return "Never";
		if (v == 0 && (k == "avoid-recent" || k == "min-percent")) return "Off";
		if (k == "respawn-delay") return v == 0 ? std::string("Off") : fmt::format("{} ms", v);
		if (k == "chaos-chance" || k == "streak-tolerance" || k == "min-percent" || k == "indicator-opacity" ||
		    k == "label-opacity" || k == "indicator-height") {
			return fmt::format("{}%", v);
		}
		return std::to_string(v);
	}
	if (k == "indicator-hold") return fmt::format("{:.1f} s", rspOpt<double>(r.key));
	return fmt::format("{:.2f}", rspOpt<double>(r.key));
}

GLubyte panelOpacity() {
	std::string s = rspOpt<std::string>("menu-style");
	if (s == "glass") return 175;
	if (s == "outline") return 110;
	return 246;
}

} // namespace

class RSPMenu : public geode::Popup {
protected:
	int m_page = 0;
	bool m_dirty = false;
	CCPoint m_c;
	std::vector<CCNode*> m_chrome, m_content;
	std::vector<CCScale9Sprite*> m_tabBg;
	std::vector<CCLabelBMFont*> m_tabLbl;
	std::vector<CCLabelBMFont*> m_vals;
	std::vector<Row const*> m_rows;

	bool init() {
		if (!Popup::init(520.f, 300.f)) return false;
		auto win = CCDirector::get()->getWinSize();
		m_c = m_buttonMenu->convertToNodeSpace({win.width / 2, win.height / 2});
		this->buildAll(false);
		return true;
	}

	// ---- small builders ----------------------------------------------------

	CCLabelBMFont* text(std::string const& s, float x, float y, float scale, ccColor3B col, CCPoint anchor, std::vector<CCNode*>& bucket) {
		auto l = CCLabelBMFont::create(s.c_str(), "bigFont.fnt");
		l->setScale(scale);
		l->setColor(col);
		l->setAnchorPoint(anchor);
		l->setPosition({m_c.x + x, m_c.y + y});
		m_buttonMenu->addChild(l, 2);
		bucket.push_back(l);
		return l;
	}

	static void fit(CCLabelBMFont* l, float maxW, float scale) {
		float w = l->getContentSize().width * scale;
		l->setScale(w > maxW && w > 0.f ? scale * maxW / w : scale);
	}

	CCMenuItemSpriteExtra* pill(std::string const& t, float w, float h, float x, float y, float scale,
	                            ccColor3B bg, ccColor3B tc, SEL_MenuHandler sel, int tag, CCLabelBMFont** out,
	                            CCScale9Sprite** outBg, std::vector<CCNode*>& bucket) {
		auto node = CCNode::create();
		node->setContentSize(CCSize(w, h));
		node->ignoreAnchorPointForPosition(false);
		auto b = CCScale9Sprite::create("square02_001.png");
		b->setContentSize(CCSize(w, h));
		b->setPosition({w / 2, h / 2});
		b->setColor(bg);
		node->addChild(b);
		auto l = CCLabelBMFont::create(t.c_str(), "bigFont.fnt");
		l->setColor(tc);
		l->setPosition({w / 2, h / 2});
		fit(l, w - 10.f, scale);
		node->addChild(l);
		auto item = CCMenuItemSpriteExtra::create(node, this, sel);
		item->setTag(tag);
		item->setPosition({m_c.x + x, m_c.y + y});
		m_buttonMenu->addChild(item, 3);
		bucket.push_back(item);
		if (out) *out = l;
		if (outBg) *outBg = b;
		return item;
	}

	static ccColor3B lighten(ccColor3B c, int a) {
		return {static_cast<GLubyte>(std::min(255, c.r + a)), static_cast<GLubyte>(std::min(255, c.g + a)), static_cast<GLubyte>(std::min(255, c.b + a))};
	}

	void slideIn(CCNode* n, float delay) {
		auto p = n->getPosition();
		n->setPositionX(p.x + 18.f);
		n->runAction(CCSequence::create(CCDelayTime::create(delay), CCEaseExponentialOut::create(CCMoveTo::create(0.32f, p)), nullptr));
	}

	// ---- layout --------------------------------------------------------------

	void buildAll(bool animate) {
		for (auto n : m_chrome) n->removeFromParent();
		m_chrome.clear();
		m_tabBg.clear();
		m_tabLbl.clear();
		auto th = rspTheme();

		auto bg = CCScale9Sprite::create("square02_001.png");
		bg->setContentSize(CCSize(512.f, 292.f));
		bg->setColor(th.panel);
		bg->setOpacity(panelOpacity());
		bg->setPosition(m_c);
		m_buttonMenu->addChild(bg, -1);
		m_chrome.push_back(bg);

		this->text(fmt::format("Random StartPos {}", kRSPVersion), 0.f, 128.f, 0.55f, th.accent, {0.5f, 0.5f}, m_chrome);

		auto const& P = pages();
		float tw = 54.f, gap = 2.f;
		float total = static_cast<float>(P.size()) * tw + static_cast<float>(P.size() - 1) * gap;
		float x0 = -total / 2 + tw / 2;
		for (size_t i = 0; i < P.size(); i++) {
			CCLabelBMFont* lb = nullptr;
			CCScale9Sprite* tb = nullptr;
			this->pill(P[i].name, tw, 22.f, x0 + static_cast<float>(i) * (tw + gap), 100.f, 0.3f, th.panel, th.dim,
			           menu_selector(RSPMenu::onTab), static_cast<int>(i), &lb, &tb, m_chrome);
			m_tabBg.push_back(tb);
			m_tabLbl.push_back(lb);
		}
		this->colorTabs();

		this->pill("Advanced...", 112.f, 20.f, -190.f, -128.f, 0.32f, lighten(th.panel, 26), th.text,
		           menu_selector(RSPMenu::onAdvanced), 0, nullptr, nullptr, m_chrome);
		this->text("Saved automatically", 240.f, -128.f, 0.28f, th.dim, {1.f, 0.5f}, m_chrome);

		this->buildPage(animate);
	}

	void colorTabs() {
		auto th = rspTheme();
		for (size_t i = 0; i < m_tabBg.size(); i++) {
			bool on = static_cast<int>(i) == m_page;
			m_tabBg[i]->setColor(on ? th.accent : lighten(th.panel, 22));
			m_tabLbl[i]->setColor(on ? th.panel : th.dim);
		}
	}

	void buildPage(bool animate) {
		for (auto n : m_content) n->removeFromParent();
		m_content.clear();
		m_vals.clear();
		m_rows.clear();
		auto th = rspTheme();
		ccColor3B lift = lighten(th.panel, 26);
		auto const& rows = pages()[m_page].rows;

		float y = 70.f;
		for (size_t i = 0; i < rows.size(); i++, y -= 21.f) {
			auto const& r = rows[i];
			m_rows.push_back(&r);
			m_vals.push_back(nullptr);
			float d = animate ? static_cast<float>(i) * 0.03f : 0.f;
			int idx = static_cast<int>(i);

			std::vector<CCNode*> made;
			this->pill("?", 16.f, 16.f, -240.f, y, 0.38f, lift, th.accent, menu_selector(RSPMenu::onInfo), idx, nullptr, nullptr, made);
			this->text(r.label, -224.f, y, 0.38f, th.text, {0.f, 0.5f}, made);

			if (r.kind == kToggle) {
				auto t = CCMenuItemToggler::createWithStandardSprites(this, menu_selector(RSPMenu::onToggle), 0.55f);
				t->toggle(rspOpt<bool>(r.key));
				t->setTag(idx);
				t->setPosition({m_c.x + 238.f, m_c.y + y});
				m_buttonMenu->addChild(t, 3);
				made.push_back(t);
			} else if (r.kind == kChoice) {
				CCLabelBMFont* lb = nullptr;
				this->pill(fmtVal(r), 112.f, 18.f, 178.f, y, 0.32f, lift, th.accent, menu_selector(RSPMenu::onCycle), idx, &lb, nullptr, made);
				m_vals[i] = lb;
			} else {
				this->pill("-", 18.f, 18.f, 142.f, y, 0.5f, lift, th.text, menu_selector(RSPMenu::onStep), idx * 2, nullptr, nullptr, made);
				this->pill("+", 18.f, 18.f, 234.f, y, 0.5f, lift, th.text, menu_selector(RSPMenu::onStep), idx * 2 + 1, nullptr, nullptr, made);
				m_vals[i] = this->text(fmtVal(r), 188.f, y, 0.34f, th.accent, {0.5f, 0.5f}, made);
			}

			for (auto n : made) {
				m_content.push_back(n);
				if (animate) this->slideIn(n, d);
			}
		}
		if (m_page == 2) {
			this->text("Seed text and the excluded list are under Advanced.", 0.f, -60.f, 0.28f, th.dim, {0.5f, 0.5f}, m_content);
		}
	}

	// ---- callbacks -----------------------------------------------------------

	void onTab(CCObject* s) {
		int i = static_cast<CCNode*>(s)->getTag();
		if (i == m_page) return;
		m_page = i;
		this->colorTabs();
		this->buildPage(true);
	}

	void onToggle(CCObject* s) {
		auto const& r = *m_rows[static_cast<CCNode*>(s)->getTag()];
		Mod::get()->setSettingValue<bool>(r.key, !rspOpt<bool>(r.key));
		m_dirty = true;
	}

	void onStep(CCObject* s) {
		int tag = static_cast<CCNode*>(s)->getTag();
		int i = tag / 2;
		double dir = (tag % 2) ? 1.0 : -1.0;
		auto const& r = *m_rows[i];
		if (r.kind == kInt) {
			int64_t v = rspOpt<int64_t>(r.key);
			int64_t nv = std::clamp<int64_t>(v + static_cast<int64_t>(dir * r.step), static_cast<int64_t>(r.lo), static_cast<int64_t>(r.hi));
			Mod::get()->setSettingValue<int64_t>(r.key, nv);
		} else {
			double v = rspOpt<double>(r.key);
			double nv = std::clamp(std::round((v + dir * r.step) * 100.0) / 100.0, r.lo, r.hi);
			Mod::get()->setSettingValue<double>(r.key, nv);
		}
		m_dirty = true;
		if (m_vals[i]) m_vals[i]->setString(fmtVal(r).c_str());
	}

	void onCycle(CCObject* s) {
		int i = static_cast<CCNode*>(s)->getTag();
		auto const& r = *m_rows[i];
		std::string cur = rspOpt<std::string>(r.key);
		auto it = std::find(r.opts.begin(), r.opts.end(), cur);
		size_t next = (it == r.opts.end()) ? 0 : static_cast<size_t>(it - r.opts.begin() + 1) % r.opts.size();
		Mod::get()->setSettingValue<std::string>(r.key, r.opts[next]);
		m_dirty = true;
		std::string k = r.key;
		if (k == "theme" || k == "menu-style") {
			// recolour everything on the next frame (the button being pressed gets rebuilt)
			this->runAction(CCSequence::create(
				CCDelayTime::create(0.01f), CCCallFunc::create(this, callfunc_selector(RSPMenu::rebuildAll)), nullptr
			));
		} else if (m_vals[i]) {
			m_vals[i]->setString(fmtVal(r).c_str());
			fit(m_vals[i], 102.f, 0.32f);
		}
	}

	void rebuildAll() {
		this->buildAll(false);
	}

	void onInfo(CCObject* s) {
		auto const& r = *m_rows[static_cast<CCNode*>(s)->getTag()];
		FLAlertLayer::create(r.label, r.info, "OK")->show();
	}

	void onAdvanced(CCObject*) {
		openSettingsPopup(Mod::get());
	}

public:
	~RSPMenu() override {
		if (m_dirty) (void)Mod::get()->saveData(); // everything you changed is saved when the menu closes
	}

	static RSPMenu* create() {
		auto ret = new RSPMenu();
		if (ret->init()) {
			ret->autorelease();
			return ret;
		}
		delete ret;
		return nullptr;
	}
};

namespace {
	struct RSPMenuRegister {
		RSPMenuRegister() {
			g_rspOpenMenu = [] {
				if (auto m = RSPMenu::create()) m->show();
			};
		}
	} s_rspMenuRegister;
