// ---------------------------------------------------------------------------
// StartPos stats (in memory while playing, saved when leaving the level)
// ---------------------------------------------------------------------------
struct RSPSection {
	int deaths = 0;
	float best = 0.f;
};
struct RSPLevelStats {
	std::map<int, RSPSection> sec; // key 1..N = StartPos number
	bool loaded = false;
};

inline std::unordered_map<int, RSPLevelStats>& rspStatsMap() {
	static std::unordered_map<int, RSPLevelStats> m;
	return m;
}
inline std::string rspStatsKey(int id) { return "stats-" + std::to_string(id); }

inline int rspLevelKey(GJGameLevel* lvl) {
	if (!lvl) return 0;
	int id = lvl->m_levelID.value();
	if (id > 0) return id;
	return -static_cast<int>(std::hash<std::string>{}(std::string(lvl->m_levelName.c_str())) & 0x7fffffff) - 1;
}

inline RSPLevelStats& rspStatsFor(int id) {
	auto& s = rspStatsMap()[id];
	if (!s.loaded) {
		s.loaded = true;
		std::string txt = Mod::get()->getSavedValue<std::string>(rspStatsKey(id), "");
		size_t pos = 0;
		while (pos < txt.size()) {
			size_t end = txt.find(';', pos);
			if (end == std::string::npos) end = txt.size();
			int k = 0, d = 0;
			float b = 0.f;
			if (std::sscanf(txt.substr(pos, end - pos).c_str(), "%d,%d,%f", &k, &d, &b) == 3) {
				s.sec[k] = RSPSection{d, b};
			}
			pos = end + 1;
		}
	}
	return s;
}

inline void rspStatsSave(int id) {
	auto it = rspStatsMap().find(id);
	if (it == rspStatsMap().end() || !it->second.loaded) return;
	std::string out;
	char buf[64];
	for (auto& [k, v] : it->second.sec) {
		std::snprintf(buf, sizeof(buf), "%d,%d,%.1f;", k, v.deaths, v.best);
		out += buf;
	}
	Mod::get()->setSavedValue<std::string>(rspStatsKey(id), out);
}

// ---------------------------------------------------------------------------
// Compatibility warnings
// ---------------------------------------------------------------------------
inline std::vector<std::string> rspConflictingMods() {
	std::vector<std::string> out;
	auto low = [](std::string s) {
		for (auto& c : s) c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
		return s;
	};
	auto has = [](std::string const& s) {
		return s.find("startpos") != std::string::npos || s.find("start pos") != std::string::npos ||
			s.find("start-pos") != std::string::npos || s.find("start_pos") != std::string::npos;
	};
	for (auto mod : Loader::get()->getAllMods()) {
		if (mod == Mod::get() || !mod->isEnabled()) continue;
		if (has(low(mod->getID())) || has(low(mod->getName()))) out.push_back(mod->getName());
	}
	return out;
}

inline void rspCompatWarn() {
	auto bad = rspConflictingMods();
	if (bad.empty()) return;
	std::string names;
	for (size_t i = 0; i < bad.size(); i++) names += (i ? ", " : "") + bad[i];
	std::string body =
		"<cy>" + names + "</c> is turned on.\n\n"
		"Random StartPos is not compatible with <cr>Smart StartPos</c> or <cr>StartPos Switcher</c>. "
		"They all decide where you respawn, so running them together can send you to the wrong spot, "
		"stop the switching, or throw your music out of sync.\n\n"
		"Please turn that mod off in <cg>Geode > Mods</c> and restart the game.";
	FLAlertLayer::create("Incompatible mod detected", body, "Got it")->show();
}

// Shown when you enter a level.
inline void rspLevelWarn() {
	if (!rspOpt<bool>("compat-warning")) return;
	if (!rspConflictingMods().empty()) {
		rspCompatWarn();
		return;
	}
	// Smart StartPos / StartPos Switcher can also be a feature inside a menu mod we can't look into.
	static bool shownGeneric = false;
	if (shownGeneric) return;
	for (char const* id : {"tobyadd.gdh", "eclipse.eclipse-menu", "thesillydoggo.qolmod"}) {
		auto mod = Loader::get()->getLoadedMod(id);
		if (mod && mod->isEnabled()) {
			shownGeneric = true;
			FLAlertLayer::create(
				"Before you play",
				"Random StartPos is not compatible with <cr>Smart StartPos</c> or <cr>StartPos Switcher</c>.\n\n"
				"If either is switched on (including inside <cy>" + mod->getName() + "</c>), "
				"please turn it off first, or the StartPos will not switch correctly.",
				"Got it"
			)->show();
			return;
		}
	}
}

inline void rspOpenSettings() {
	if (g_rspOpenMenu) {
		g_rspOpenMenu();
	} else {
		FLAlertLayer::create(
			"In-game menu missing",
			"The Random StartPos in-game menu is not part of this build (menu.cpp is missing or failed to build), "
			"so Geode's own settings page is opening instead.",
			"OK"
		)->show();
		openSettingsPopup(Mod::get());
	}
}

// ---------------------------------------------------------------------------
// Popup layout helper: a label placed at an offset from the popup centre.
// align: 0 = centred on x, 1 = starts at x, 2 = ends at x
// ---------------------------------------------------------------------------
inline CCLabelBMFont* rspLabel(CCNode* parent, std::string const& s, float x, float y, float scale,
                               ccColor3B col, int align, std::vector<CCNode*>* bucket = nullptr) {
	auto l = CCLabelBMFont::create(s.c_str(), "bigFont.fnt");
	l->setScale(scale);
	l->setColor(col);
	float w = l->getScaledContentSize().width;
	float cx = align == 1 ? x + w / 2 : align == 2 ? x - w / 2 : x;
	parent->addChildAtPosition(l, Anchor::Center, {cx, y});
	if (bucket) bucket->push_back(l);
	return l;
}
