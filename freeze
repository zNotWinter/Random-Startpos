// Optional module: the respawn delay.
// After a switch the game is held for N ms so you can see where you landed, and the
// music only starts when the hold ends so it stays in sync with the level.
// If this file ever fails to compile, delete it: the rest of the mod still works.
#include "rsp.hpp"

#include <Geode/modify/PlayLayer.hpp>
#include <Geode/modify/GJBaseGameLayer.hpp>

namespace {
	bool s_hold = false;         // the level is held still
	bool s_musicSkipped = false; // the game tried to start the music during the hold
	constexpr int kHoldTag = 7701;
}

struct $modify(RSPFreezeLayer, PlayLayer) {
	void setupHasCompleted() {
		s_hold = false;
		s_musicSkipped = false;
		PlayLayer::setupHasCompleted();
	}

	void onQuit() {
		s_hold = false;
		s_musicSkipped = false;
		PlayLayer::onQuit();
	}

	void resetLevel() {
		if (g_rspFreezeNext) {
			g_rspFreezeNext = false;
			if (rspEnabled()) {
				int ms = static_cast<int>(rspOpt<int64_t>("respawn-delay"));
				if (ms > 0) {
					s_hold = true;
					s_musicSkipped = false;
					this->stopActionByTag(kHoldTag);
					auto seq = CCSequence::create(
						CCDelayTime::create(static_cast<float>(ms) / 1000.f),
						CCCallFunc::create(this, callfunc_selector(RSPFreezeLayer::rspRelease)),
						nullptr
					);
					seq->setTag(kHoldTag);
					this->runAction(seq);
				}
			}
		}
		PlayLayer::resetLevel();
	}

	// The music starts when the hold ends, not while the level is held still.
	void startMusic() {
		if (s_hold && rspOpt<bool>("hold-music")) {
			s_musicSkipped = true;
			return;
		}
		PlayLayer::startMusic();
	}

	void rspRelease() {
		s_hold = false;
		if (s_musicSkipped) {
			s_musicSkipped = false;
			PlayLayer::startMusic();
		}
	}
};

// While held, the level simply does not advance.
struct $modify(RSPFreezeBase, GJBaseGameLayer) {
	void update(float dt) {
		if (s_hold) return;
		GJBaseGameLayer::update(dt);
	}
};
